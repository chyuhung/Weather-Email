# Weather-Email 环境变量配置示例
# 复制本文件为 .env，填写实际值后使用
# .env 文件不会被提交到 Git（已在 .gitignore 中忽略）

# ===========================================
# 天气配置
# ===========================================

# 经纬度（必填）：格式 "经度,纬度"
# 示例：116.3176,39.9760
LOCATION=

# 彩云天气 API Token（必填）
# 申请地址：https://open.caiyunapp.com
CAIYUN_TOKEN=

# 高德地图 Key（建议填写，用于城市名反查）
# 申请地址：https://console.amap.com/dev/key/app
GAODE_KEY=

# 天气数据源（可选，默认 caiyun）
# caiyun = 彩云天气（数据丰富，推荐）
# gaode  = 高德天气
WEATHER_SOURCE=caiyun

# ===========================================
# 邮件配置
# ===========================================

# 发件人邮箱
EMAIL_SENDER=

# 邮箱授权码（非登录密码）
# 腾讯企业邮箱：https://exmail.qq.com → 邮箱设置 → 客户端授权
EMAIL_AUTH_CODE=

# 收件人（单人）
EMAIL_RECEIVER=

# 收件人（多人，逗号分隔，优先于 EMAIL_RECEIVER）
# EMAIL_RECEIVERS=user1@example.com,user2@example.com